{
  "name": "lean-init-ide",
  "private": true,
  "type": "module",
  "description": "Browser-native Lean 4 Init IDE: Monaco + the upstream Lean language server running in WebAssembly workers.",
  "scripts": {
    "postinstall": "node scripts/patch-lsp.mjs",
    "predev": "node scripts/patch-lsp.mjs && node scripts/fetch-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/patch-lsp.mjs && node scripts/fetch-assets.mjs",
    "build": "vite build",
    "build:web": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "fetch:assets": "node scripts/fetch-assets.mjs"
  },
  "dependencies": {
    "@wasm-idle/core": "^1.3.0",
    "@wasm-idle/lsp": "1.3.0",
    "monaco-editor": "^0.57.0",
    "vscode-jsonrpc": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.0.0"
  }
}
