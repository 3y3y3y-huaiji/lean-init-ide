{
  "name": "lean-init-ide",
  "private": true,
  "type": "module",
  "license": "(Apache-2.0 OR MulanPSL-2.0)",
  "description": "Browser-native Lean 4 Init IDE: Monaco + the upstream Lean language server running in WebAssembly workers.",
  "scripts": {
    "postinstall": "node scripts/patch-lsp.mjs",
    "dev": "vite",
    "predev": "node scripts/patch-lsp.mjs && node scripts/fetch-assets.mjs && npm run build:sw",
    "build": "vite build",
    "prebuild": "node scripts/patch-lsp.mjs && node scripts/fetch-assets.mjs && npm run build:sw",
    "build:web": "npm run build:sw && vite build",
    "build:sw": "esbuild src/sw.ts --bundle --format=iife --target=es2022 --outfile=public/sw.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sw.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch:assets": "node scripts/fetch-assets.mjs",
    "upload:assets": "node scripts/upload-assets.mjs",
    "r2:cors": "npx -y wrangler r2 bucket cors set lean4-ide-releases --file config/r2-cors.json --force"
  },
  "dependencies": {
    "@wasm-idle/core": "^1.3.0",
    "@wasm-idle/lsp": "1.3.0",
    "monaco-editor": "^0.57.0",
    "vscode-jsonrpc": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  }
}
