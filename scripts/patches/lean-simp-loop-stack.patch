+/-- `simpLoop` 在线性重写链上的续延：子表达式简化完成后，把结果接回 `r` 的
+证明链，并以 `e` 为 key 写回缓存。 -/
+private structure SimpLoopCont where
+  e   : Expr
+  cfg : Config
+  r   : Result
+
+/-- 显式续延栈版 `simpLoop` 的工作项：处理表达式，或沿续延栈回退。 -/
+private inductive SimpLoopTask where
+  | eval   (e : Expr) (conts : List SimpLoopCont)
+  | finish (r : Result) (conts : List SimpLoopCont)
+
+/-- 显式续延栈版 `simpLoop`。
+
+`visitPreContinue` / `visitPostContinue` 里对 `simpLoop` 的自调用原本不是尾调用
+（返回后还要 `mkEqTrans` 与 `cacheResult`），每重写一步会在 wasm 原生栈上留两个帧。
+这里把续延放进 `List SimpLoopCont`，`eval` / `finish` 之间只有尾调用，
+重写链再长也只占堆内存；重写步数仍由 `maxSteps` 限制。 -/
+private partial def simpLoopStep (task : SimpLoopTask) : SimpM Result := do
+  match task with
+  | .eval e conts =>
+    let cfg ← getConfig
+    let cached? ← if cfg.memoize then do
+        let s ← get
+        pure (s.cache.find? e)
+      else
+        pure none
+    match cached? with
+    | some r => simpLoopStep (.finish r conts)
+    | none =>
+      if (← get).numSteps > cfg.maxSteps then
+        throwError "`simp` failed: maximum number of steps exceeded"
+      else
+        checkSystem "simp"
+        modify fun s => { s with numSteps := s.numSteps + 1 }
+        match (← pre e) with
+        | .done r  => simpLoopStep (.finish (← cacheResult e cfg r) conts)
+        | .visit r => simpLoopStep (.eval r.expr ({ e, cfg, r } :: conts))
+        | .continue none => simpLoopStep (← visitPreContinue e cfg { expr := e } conts)
+        | .continue (some r) => simpLoopStep (← visitPreContinue e cfg r conts)
+  | .finish r conts =>
+    match conts with
+    | [] => return r
+    | c :: cs =>
+      let r ← c.r.mkEqTrans r
+      let r ← cacheResult c.e c.cfg r
+      simpLoopStep (.finish r cs)
