{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://lean-init-ide.pages.dev",
          "https://*.lean-init-ide.pages.dev",
          "https://oke.ccwu.cc",
          "http://localhost:5173",
          "http://localhost:4173",
          "http://127.0.0.1:5173",
          "http://127.0.0.1:4173"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["range", "if-none-match", "if-modified-since", "content-type"]
      },
      "exposeHeaders": [
        "content-range",
        "accept-ranges",
        "content-length",
        "etag",
        "last-modified"
      ],
      "maxAgeSeconds": 86400
    }
  ]
}
